---
import '../styles/globals.css';
import MaintenanceBlocker from '../components/MaintenanceBlocker';

interface Props {
	title?: string;
	description?: string;
	noFooter?: boolean;
}

const {
	title = 'Loket PTSP',
	description = 'Sistem Antrian Digital Pelayanan Terpadu Satu Pintu Kantor Kementerian Agama Kabupaten Barito Utara',
	noFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="id" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Loket PTSP Kemenag Barito Utara</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>
	<body class="bg-night-950 text-slate-200 overflow-x-hidden">
		<MaintenanceBlocker client:only="react" />
		<slot />

		{!noFooter && (
			<footer class="border-t border-white/5 py-6 text-center text-sm text-slate-500">
				<div class="mx-auto max-w-7xl px-4">
					© {new Date().getFullYear()} Kantor Kementerian Agama Kabupaten Barito Utara. PTSP — Pelayanan Terpadu Satu Pintu.
				</div>
			</footer>
		)}
	</body>
</html>
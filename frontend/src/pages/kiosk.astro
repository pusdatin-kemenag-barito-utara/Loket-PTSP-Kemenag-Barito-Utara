---
import Layout from '../layouts/Layout.astro';
import ParticleBackground from '../components/ParticleBackground';
import Logo from '../components/Logo';
import KioskApp from '../components/KioskApp';
---

<Layout title="Kiosk Antrian" noFooter>
	<header class="border-b border-white/5">
		<nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5">
			<Logo />
			<a href="/" class="btn btn-ghost px-4 py-2 text-sm">← Kembali</a>
		</nav>
	</header>

	<main class="relative min-h-[calc(100vh-5rem)] pb-16">
		<KioskApp client:load />
	</main>

	<ParticleBackground client:load />
</Layout>
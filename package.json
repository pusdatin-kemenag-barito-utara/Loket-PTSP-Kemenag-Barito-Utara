{
  "name": "loket-ptsp-kemenag",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "infisical run --path=/loket-kemenag --env=dev -- npm run dev:all",
    "dev:all": "concurrently -k -n FE,BE -c cyan,green \"npm:dev:fe\" \"npm:dev:be\"",
    "dev:fe": "cross-env ASTRO_DEV_BACKGROUND=1 npm run dev --workspace frontend",
    "dev:be": "cd backend && air",
    "build": "npm run build --workspace frontend",
    "build:fe": "npm run build --workspace frontend",
    "build:be": "cd backend && go build -ldflags=\"-s -w\" -o bin/server.exe ./cmd/server",
    "build:all": "npm run build:fe && npm run build:be",
    "install:all": "npm install && npm run install:be",
    "install:be": "cd backend && go mod download",
    "install:air": "go install github.com/air-verse/air@latest",
    "seed": "infisical run --path=/loket-kemenag --env=dev -- npm run seed:raw",
    "seed:raw": "cd backend && go run ./cmd/seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0"
  }
}
